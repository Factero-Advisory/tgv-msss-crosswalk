# ---- Systeme d'exploitation ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Fichiers temporaires bureautique ----
~$*.xlsx
~$*.xls
~$*.docx
~$*.pptx
.~lock.*

# ---- Python (outillage du depot) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- Node (si outillage front ajoute plus tard) ----
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ---- Editeurs ----
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---- Sorties locales et travail en cours ----
/tmp/
/scratch/
*.log
*.bak
*.orig
*.rej

# ---- Secrets : ne jamais versionner ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.yaml

# ---- Artefacts de generation ----
# Le site est genere puis versionne volontairement (GitHub Pages sert la racine).
# Ne pas ignorer /fr, /en, /assets, sitemap.xml, robots.txt, llms*.txt.
/site_out/
/build/
/dist/
